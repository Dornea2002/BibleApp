<resources>
    <style name="RoundedCornerImageStyle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/border_corner_radius</item>
    </style>

    <style name="CardLabelTextStyle" parent="">
        <item name="android:textColor">@color/on_secondary</item>
        <item name="android:textSize">@dimen/card_label_text_size</item>
        <item name="android:fontFamily">@font/caveat_bold</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="CardMetadataTitleTextStyle" parent="">
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">@color/text_color</item>
        <item name="android:textSize">@dimen/card_metadata_title_text_size</item>
        <item name="android:fontFamily">@font/lora_regular</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CardMetadataChannelTextStyle" parent="">
        <item name="android:textColor">@color/text_color</item>
        <item name="android:textSize">@dimen/card_metadata_channel_text_size</item>
        <item name="android:fontFamily">@font/lora_regular</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DailyVerseTextStyle" parent="CardMetadataChannelTextStyle">
        <item name="android:textSize">@dimen/daily_verse_text_size</item>
    </style>
</resources>